# ---------------------------------------------------------------------------
# Twin for Travel — environment configuration
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# MongoDB connection string, including the database name.
# Local:  mongodb://127.0.0.1:27017/twin_for_travel
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/twin_for_travel?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/twin_for_travel

# Secret used to sign admin session JWTs. Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates every existing admin session.
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public origin of the deployment. Used for canonical URLs, Open Graph,
# sitemap entries and the same-origin (CSRF) check on mutating API requests.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional -------------------------------------------------------------

# Timezone the company operates in. Trip day boundaries are interpreted here.
# Default: Africa/Cairo
SITE_TIMEZONE=Africa/Cairo

# Media storage backend: "local" (development only) or "cloudinary".
# Default: local
STORAGE_PROVIDER=local

# --- Local storage provider (STORAGE_PROVIDER=local) -----------------------
# Directory uploads are written to, relative to the project root.
# It must sit inside `public/` so the files are served statically.
# Not suitable for serverless hosting — the filesystem is ephemeral there.
# Default: public/uploads
UPLOAD_DIR=public/uploads

# --- Cloudinary provider (STORAGE_PROVIDER=cloudinary) ---------------------
# All three are required when STORAGE_PROVIDER=cloudinary. Server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder that uploads are placed in. Default: twin-for-travel
CLOUDINARY_FOLDER=twin-for-travel
